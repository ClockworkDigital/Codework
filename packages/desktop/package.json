{
  "name": "@opencode/desktop",
  "private": true,
  "version": "2.0.29",
  "type": "module",
  "license": "MIT",
  "homepage": "https://opencode.ai",
  "author": {
    "name": "OpenCode",
    "email": "hello@opencode.ai"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "test": "bun test --preload ./test/preload.ts --timeout 30000",
    "dev": "bun ./scripts/dev.ts",
    "migration": "bun ./scripts/migration.ts",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder --config electron-builder.config.ts",
    "package:mac": "electron-builder --mac --config electron-builder.config.ts",
    "package:win": "electron-builder --win --config electron-builder.config.ts",
    "package:linux": "electron-builder --linux --config electron-builder.config.ts",
    "bench:startup": "bun ./scripts/bench-startup.ts",
    "install:wpp": "bun ./scripts/install-wpp.ts",
    "test:wpp": "CM_WPP=1 bun test --preload ./test/preload.ts --timeout 30000 ./wpp/contracts.test.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@zip.js/zip.js": "2.7.62",
    "electron-context-menu": "5.0.0",
    "electron-log": "^5",
    "electron-updater": "6.8.9",
    "lighthouse": "13.4.1",
    "csv-parse": "6.1.0",
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "@brendonovich/vite-plugin-opencode": "0.1.3",
    "@effect/platform-node": "catalog:",
    "@lydell/node-pty": "catalog:",
    "@opencode/app": "workspace:*",
    "@opencode/gui-extensions": "workspace:*",
    "@opencode/client": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/ui": "workspace:*",
    "@sentry/solid": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@solidjs/router": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "app-builder-lib": "26.15.7",
    "drizzle-kit": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "electron": "44.4.5",
    "electron-builder": "26.15.7",
    "electron-vite": "6.0.0-beta.1",
    "magic-string": "0.30.21",
    "solid-js": "catalog:",
    "typescript": "~5.6.2",
    "vite": "8.2.2",
    "@cookiemonster/cm-browser": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@opencode/sdk": "workspace:*",
    "@opencode/plugin-figma": "workspace:*"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.12",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.12"
  },
  "imports": {
    "#cm-wpp": {
      "cm-wpp": "./wpp/index.mjs",
      "default": "./src/main/wpp.ts"
    }
  }
}
